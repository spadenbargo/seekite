{
  "name": "@seekite/svelte",
  "version": "0.1.0-alpha.0",
  "description": "Headless Svelte binding for Seekite search state",
  "keywords": [
    "headless-ui",
    "search",
    "svelte"
  ],
  "homepage": "https://seekite.badenspargo.com/docs/framework-adapters",
  "bugs": {
    "url": "https://github.com/spadenbargo/seekite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spadenbargo/seekite.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seekite/search-ui": "workspace:*"
  },
  "devDependencies": {
    "svelte": "5.58.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
