{
  "name": "@seekite/build",
  "version": "0.1.0-alpha.0",
  "description": "Shared indexing pipeline for Seekite",
  "keywords": [
    "indexing",
    "local-first",
    "search",
    "static-site"
  ],
  "homepage": "https://seekite-docs.baden-spargo.workers.dev/docs/configuration",
  "bugs": {
    "url": "https://github.com/spadenbargo/seekite/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spadenbargo/seekite.git",
    "directory": "packages/build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seekite/core": "workspace:*",
    "cheerio": "^1.1.0",
    "gray-matter": "^4.0.3",
    "jiti": "^2.5.1",
    "marked": "^16.0.0",
    "picomatch": "^4.0.0",
    "tinyglobby": "^0.2.14"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.0"
  },
  "optionalDependencies": {
    "@seekite/engine-native": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
