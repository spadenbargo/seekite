{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seekite-docs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "seekite.badenspargo.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
  },
}
