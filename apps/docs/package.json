{
  "name": "@seekite/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node ./scripts/stage-static-search.mjs && node ./scripts/verify-static.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "preview": "vp preview",
    "sync:brand-icons": "node ./scripts/sync-brand-icons.mjs",
    "test": "vp test run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seekite/core": "workspace:*",
    "@seekite/embeddings-ternlight": "workspace:*",
    "@seekite/lab": "workspace:*",
    "@seekite/react": "workspace:*",
    "@tanstack/highlight": "0.0.10",
    "@tanstack/markdown": "0.0.13",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "fumadocs-core": "16.15.1",
    "fumadocs-ui": "16.15.1",
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@seekite/vite": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.34",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "gray-matter": "4.0.3",
    "lighthouse": "13.4.1",
    "marked": "16.4.2",
    "seekite": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tinyglobby": "0.2.17",
    "typescript": "^5.9.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.125.0"
  }
